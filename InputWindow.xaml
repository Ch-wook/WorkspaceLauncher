<Window x:Class="WorkspaceLauncher.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="입력" Height="180" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        WindowStyle="ToolWindow">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtPrompt" Text="입력하세요:" FontSize="13"
                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

        <TextBox x:Name="txtInput" Grid.Row="1" Margin="0,0,0,16"
                 Height="32" FontSize="13" VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="확인" Style="{StaticResource AccentButton}"
                    Width="90" Margin="0,0,8,0" Click="btnOk_Click" IsDefault="True"/>
            <Button Content="취소" Style="{StaticResource ModernButton}"
                    Width="90" Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
