<Window x:Class="WorkspaceLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workspace Launcher" Height="620" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ==================== Custom Title Bar ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="🚀" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Workspace Launcher" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="v2.0" FontSize="10" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}" Margin="8,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button Content="─" Style="{StaticResource TitleBarButton}" Click="btnMinimize_Click"/>
                    <Button Content="□" Style="{StaticResource TitleBarButton}" Click="btnMaximize_Click"/>
                    <Button Content="✕" Style="{StaticResource CloseButton}" Click="btnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Main Content ==================== -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== Left: Workspace Sidebar ========== -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondary}"
                    CornerRadius="10" Margin="0,0,8,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="📁 작업 공간" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="8,4,0,12"/>

                    <ListBox x:Name="lstWorkspaces" Grid.Row="1"
                             DisplayMemberPath="Name"
                             SelectionChanged="lstWorkspaces_SelectionChanged"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource WorkspaceListBoxItem}"
                             MouseDoubleClick="lstWorkspaces_MouseDoubleClick"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,10,0,4">
                        <Button Content="+ 추가" Style="{StaticResource ModernButton}"
                                Width="85" Margin="0,0,6,0" Click="btnAddWorkspace_Click"/>
                        <Button Content="삭제" Style="{StaticResource DangerButton}"
                                Width="75" Click="btnRemoveWorkspace_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== Right: App Items Panel ========== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock x:Name="txtSelectedWorkspace" Grid.Row="0"
                           Text="작업 공간을 선택하세요" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" Margin="4,0,0,10"/>

                <!-- Drag & Drop Zone -->
                <Border x:Name="dropZone" Grid.Row="1"
                        Background="{StaticResource DropZoneBg}"
                        BorderBrush="{StaticResource DropZoneBorder}"
                        BorderThickness="2" CornerRadius="10"
                        Margin="0,0,0,10" Padding="20,14"
                        AllowDrop="True"
                        DragEnter="DropZone_DragEnter"
                        DragLeave="DropZone_DragLeave"
                        Drop="DropZone_Drop">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📂" FontSize="26" HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="프로그램 파일(.exe, .lnk)을 여기에 끌어다 놓으세요"
                                   FontSize="12" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="바탕화면의 바로가기도 드래그 가능합니다"
                                   FontSize="10" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"
                                   Opacity="0.7"/>
                    </StackPanel>
                </Border>

                <!-- App Items List -->
                <ListBox x:Name="lstAppItems" Grid.Row="2"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource AppItemListBoxItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="lstAppItems_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon: 프로그램은 추출 아이콘, 웹사이트는 이모지 -->
                                <Grid Grid.Column="0" Width="32" Height="32">
                                    <TextBlock Text="{Binding IconEmoji}" FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Image Source="{Binding IconSource}"
                                           Width="28" Height="28"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>

                                <!-- Name & Path -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Path}" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                                </StackPanel>

                                <!-- Type Badge -->
                                <Border Grid.Column="2" CornerRadius="4" Padding="8,3"
                                        VerticalAlignment="Center" Background="{StaticResource BgPrimary}">
                                    <TextBlock Text="{Binding ItemTypeDisplay}" FontSize="10"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,10,0,8">
                    <Button Content="🖥 프로그램 추가" Style="{StaticResource ModernButton}"
                            Margin="0,0,6,0" Click="btnAddProgram_Click"/>
                    <Button Content="🌐 웹사이트 추가" Style="{StaticResource ModernButton}"
                            Margin="0,0,6,0" Click="btnAddWebsite_Click"/>
                    <Button Content="삭제" Style="{StaticResource DangerButton}"
                            Width="60" Click="btnRemoveApp_Click"/>
                </StackPanel>

                <!-- Launch Button -->
                <Button x:Name="btnLaunch" Grid.Row="4" Style="{StaticResource AccentButton}"
                        Height="50" Click="btnLaunch_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚀" FontSize="18" Margin="0,0,8,0"
                                   VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock x:Name="txtLaunchButton" Text="일괄 실행" FontSize="16"
                                   FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ==================== Status Bar ==================== -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock x:Name="txtStatus" Text="준비" FontSize="11"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtItemCount" Text="" FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
